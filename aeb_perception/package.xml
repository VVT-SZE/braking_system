<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeb_perception</name>
  <version>0.1.0</version>
  <description>
    LiDAR -> CenterPoint (MMDetection3D) -> autoware_perception_msgs/DetectedObjects
    perception node, plusz egy adapter node a braking_system (crp_msgs) fele.
  </description>
  <maintainer email="darabosbeni@gmail.com">Beni</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>crp_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- A crp_msgs csomag FORRÁSA nincs a braking_system repóban - csak
       find_package(crp_msgs REQUIRED) van benne. Valahol a ti ROS2
       workspace-etekben (vagy a tanári infrastruktúrában) már léteznie
       kell, különben a braking_system maga sem fordulna le. Ha a
       colcon build itt nem találja, az nem ennek a package.xml-nek a
       hibája - a crp_msgs-t kell megtalálni/hozzáadni a workspace-hez. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
